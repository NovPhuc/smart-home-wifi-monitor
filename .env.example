# An Tâm Home - Production Environment Variables
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env lên Git!

# =============================================================================
# SECURITY (BẮT BUỘC)
# =============================================================================

# Secret key ký session cookie. Sinh bằng:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Nếu không đặt, server tự sinh và lưu vào data/secret_key
SMART_HOME_SECRET_KEY=

# Bật secure cookie (chỉ gửi qua HTTPS). BẮT BUỘC khi dùng HTTPS.
SMART_HOME_SECURE_COOKIE=1

# Trust reverse proxy (Nginx/Cloudflare). Chỉ bật khi server thực sự sau proxy.
# Nếu bật sai, client có thể giả X-Forwarded-For để vượt rate limit.
SMART_HOME_TRUST_PROXY=1

# =============================================================================
# DATABASE
# =============================================================================

# Đường dẫn SQLite (mặc định data/smarthome.db)
# Có thể dùng PostgreSQL/MySQL: postgresql://user:pass@host:port/dbname
SMART_HOME_DATABASE=data/smarthome.db

# =============================================================================
# SSL/TLS (HTTPS)
# =============================================================================

# Đường dẫn chứng chỉ SSL (PEM format). Dùng cho HTTPS trực tiếp (không qua Nginx).
# Nếu dùng Nginx/Cloudflare làm SSL termination thì không cần.
SMART_HOME_SSL_CERT=./certs/cert.pem
SMART_HOME_SSL_KEY=./certs/key.pem

# =============================================================================
# REDIS (DISTRIBUTED DEPLOYMENT)
# =============================================================================

# Bật Redis khi chạy nhiều instance Flask (scale horizontal) hoặc cần
# shared rate limit/session cache giữa các container.
# Mặc định: không dùng (fallback về RAM).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password  # Optional

# =============================================================================
# SSL/LET'S ENCRYPT (NGINX + CERTBOT)
# =============================================================================

# Domain cho Let's Encrypt (ví dụ: an-tam.example.com)
DOMAIN=an-tam.example.com

# Email cho Certbot (nhận thông báo hết hạn)
CERTBOT_EMAIL=admin@example.com

# =============================================================================
# CLOUDFLARE TUNNEL (ALTERNATIVE TO NGINX SSL)
# =============================================================================

# Token Cloudflare Tunnel (tạo tại: https://dash.cloudflare.com/ > Zero Trust > Tunnels)
# Nếu dùng Cloudflare Tunnel thì KHÔNG cần Nginx + Certbot.
# Tạo tunnel: cloudflared tunnel create an-tam-home
# Lấy token: cloudflared tunnel token YOUR_TUNNEL_ID
CLOUDFLARE_TUNNEL_TOKEN=

# =============================================================================
# WEBHOOK ALERTS
# =============================================================================

# URL webhook nhận cảnh báo CRITICAL (Telegram, ntfy.sh, IFTTT, Slack, etc.)
# Format JSON POST: {event, home_id, home, status, room, reasons, timestamp}
# Ví dụ ntfy.sh: https://ntfy.sh/your-topic-name
# Ví dụ Telegram bot: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
# Ví dụ IFTTT: https://maker.ifttt.com/trigger/alert/with/key/YOUR_KEY
WEBHOOK_URL=

# =============================================================================
# SERVER SETTINGS
# =============================================================================

# Host/port Flask app (chỉ Nginx/Cloudflare truy cập, không expose ra ngoài)
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# =============================================================================
# DOMAIN CONFIG (CHO ANDROID CERT PINNING)
# =============================================================================

# Domain thật khi chạy HTTPS (tunnel/ngrok/domain riêng).
# Cập nhật file: android_collector/app/src/main/res/xml/network_security_config.xml
# Và: android_collector/app/src/main/res/raw/cert_pins.txt
# Sinh pin: openssl x509 -in cert.pem -pubkey -noout | openssl pkey -pubin -outform DER | openssl dgst -sha256 -binary | base64

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# PYTHONPATH (cần thiết cho pytest)
PYTHONPATH=src

# Flask debug mode (KHÔNG dùng production)
# FLASK_DEBUG=1