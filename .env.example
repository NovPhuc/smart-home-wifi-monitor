# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit .env lên Git (đã có trong .gitignore).

PYTHONPATH=src

# Khóa ký session cookie. Sinh bằng:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Nếu bỏ trống, server tự sinh và lưu vào data/secret_key.
SMART_HOME_SECRET_KEY=

# Đặt 1 để buộc cookie chỉ gửi qua HTTPS (bật khi chạy phía sau tunnel HTTPS).
SMART_HOME_SECURE_COOKIE=0

# Chỉ đặt 1 khi server nằm sau reverse proxy tin cậy (nginx/Caddy…).
# Bật khi client kết nối trực tiếp sẽ cho phép giả X-Forwarded-For để vượt rate limit.
SMART_HOME_TRUST_PROXY=0

# Đường dẫn database (mặc định data/smarthome.db).
# SMART_HOME_DATABASE=data/smarthome.db
