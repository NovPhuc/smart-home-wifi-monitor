# .dockerignore — thu nhỏ build context và tránh đưa bí mật/dữ liệu vào image
# (Dockerfile stage dev/full-source dùng COPY . . — không loại trừ thì image
# sẽ chứa .venv ~2GB, database người dùng thật và khóa session.)

# Bytecode & cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Môi trường Python
.venv/
venv/
env/

# Dữ liệu và bí mật — KHÔNG BAO GIỜ vào image (prod mount volume riêng)
data/
models/
models/homes/
.env
.env.*
!.env.example
data/secret_key
*.db
*.db-shm
*.db-wal
*.sqlite
certs/
certbot-www/
hub/

# IDE & OS
.vscode/
.idea/
*.swp
.DS_Store

# Logs & artifacts
*.log
train_*.log
runlogs/
notebooks/
backup_original/
output/

# Android build (chỉ cần source)
android_collector/.gradle/
android_collector/.idea/
android_collector/.kotlin/
android_collector/build/
android_collector/app/build/
android_collector/local.properties
android_collector/app/build/outputs/

# Công cụ làm việc cục bộ + tài liệu nháp
.git/
.github/
.tmp/
.trace-mcp/
.playwright-cli/
*.bat
Dockerfile.zip
chay-2-agent.ps1
SECURITY_AUDIT_REPORT.md
BAO_CAO_KHOA_LUAN.docx
BAO_CAO_KHOA_LUAN.md
BAO_CAO_KET_QUA.docx
