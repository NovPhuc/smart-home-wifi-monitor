# .dockerignore — loại trừ file không cần cho Docker build

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.ruff_cache
.mypy_cache

# Virtual env
.venv
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Android build
android_collector/.gradle/
android_collector/app/build/
android_collector/build/
android_collector/local.properties
android_collector/*.iml
android_collector/.idea/
android_collector/.kotlin/

# Logs & temp
*.log
train_*.bat
.train/
.tmp/
.trace-mcp/
.playwright-cli/
backup_original/
runlogs/
notebooks/

# Data & models (sẽ mount volume riêng)
data/
models/

# Environment
.env
.env.local
.env.*.local

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/

# OS
.DS_Store
Thumbs.db