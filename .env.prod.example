# =============================================================================
# .env.prod.example — mẫu biến môi trường cho docker-compose.prod.yml
#
#   copy .env.prod.example .env.prod
#   # sửa các giá trị bên dưới, rồi:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# .env.prod KHÔNG được commit (đã có trong .gitignore: .env*).
# =============================================================================

# --- Bắt buộc ---------------------------------------------------------------

# Tên miền thật, phải khớp CHÍNH XÁC với `server_name` và hai dòng
# `ssl_certificate` trong nginx.conf. Đổi một nơi mà quên nơi kia thì nginx
# không khởi động được. Lệnh đổi cả hai chỗ:
#   powershell: (Get-Content nginx.conf -Raw) -replace 'an-tam\.example\.com','ten-mien-cua-ban' | Set-Content nginx.conf -Encoding UTF8
DOMAIN=an-tam.example.com

# Email nhận thông báo hết hạn chứng chỉ của Let's Encrypt.
CERTBOT_EMAIL=admin@example.com

# Khóa ký session cookie (32 byte hex). Sinh bằng:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Để trống thì ứng dụng tự sinh và lưu data/secret_key — chạy được, nhưng mọi
# phiên đăng nhập sẽ mất nếu volume data/ bị xóa. Production nên đặt tường minh.
SMART_HOME_SECRET_KEY=

# --- Chỉ cần khi dùng Cloudflare Tunnel -------------------------------------
# Lấy ở Cloudflare Zero Trust > Networks > Tunnels > (tunnel) > Install connector.
# Có token này thì KHÔNG cần mở cổng 80/443 ra Internet và không cần certbot.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Để trống nếu không chạy HTTPS trực tiếp ở tầng ứng dụng ---------------
# Nginx đã lo TLS, nên thường để trống. Chỉ đặt khi cho app tự chạy HTTPS.
SMART_HOME_SSL_CERT=
SMART_HOME_SSL_KEY=
